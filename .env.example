# Server
PORT=3847
ADMIN_PASSWORD=change-me

# Where signup notifications go (catchall)
MAIL_TO=statenislandsnowremovals@gmail.com

# From address (use the same Gmail you authenticate with)
MAIL_FROM=statenislandsnowremovals@gmail.com

# Gmail SMTP — use an App Password, never your normal Gmail password.
# Set these on the HOSTED API (Railway/Render/Fly), not inside the mobile app binary.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=statenislandsnowremovals@gmail.com
SMTP_PASS=your-16-char-app-password-here

# Mobile app (Capacitor): set the live API URL in www/config.js as API_BASE_URL
# e.g. https://your-service.up.railway.app
# Do not put SMTP secrets in the mobile app.
